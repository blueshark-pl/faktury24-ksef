# Overrides for CakeDC/Users PL to eliminate mixed EN/PL UI
# Domain used by plugin: __d('cake_d_c/users', ...)

msgid "Please enable Google Authenticator first."
msgstr "Najpierw włącz Google Authenticator."

msgid "Verification code is invalid. Try again"
msgstr "Kod weryfikacyjny jest nieprawidłowy. Spróbuj ponownie."

msgid "Could not associate account, please try again."
msgstr "Nie udało się powiązać konta. Spróbuj ponownie."

msgid "Social account was associated."
msgstr "Konto społecznościowe zostało powiązane."

msgid "Could not proceed with social account. Please try again"
msgstr "Nie udało się kontynuować logowania przez konto społecznościowe. Spróbuj ponownie."

msgid "Could not identify your account, please try again"
msgstr "Nie udało się zidentyfikować konta. Spróbuj ponownie."

msgid "Social account already associated to another user"
msgstr "To konto społecznościowe jest już powiązane z innym użytkownikiem."

msgid "Could not find user data"
msgstr "Nie znaleziono danych użytkownika."

msgid "Could not verify, please try again"
msgstr "Nie udało się zweryfikować. Spróbuj ponownie."

msgid "Google Authenticator token was successfully reset"
msgstr "Token Google Authenticator został zresetowany."

msgid "Reset Google Authenticator Token"
msgstr "Zresetuj token Google Authenticator"

msgid "Role: {0}"
msgstr "Rola: {0}"

msgid "Role"
msgstr "Rola"

msgid "User could not be added:"
msgstr "Nie udało się dodać użytkownika:"

msgid "Change Password"
msgstr "Zmień hasło"

msgid "First Name"
msgstr "Imię"

msgid "Last Name"
msgstr "Nazwisko"

msgid "Token Expires"
msgstr "Wygaśnięcie tokenu"

msgid "Activation Date"
msgstr "Data aktywacji"

msgid "Tos Date"
msgstr "Data akceptacji regulaminu"

msgid "Connected with {0}"
msgstr "Połączono z {0}"

msgid "Connect with {0}"
msgstr "Połącz z {0}"

msgid "Are you sure you want to reset token for user \"{0}\"?"
msgstr "Na pewno chcesz zresetować token dla użytkownika „{0}”?"

msgid "Verification Code"
msgstr "Kod weryfikacyjny"

msgid "Verify"
msgstr "Zweryfikuj"

msgid "Verifying..."
msgstr "Weryfikowanie..."

msgid "Don't share the verification code with anyone!"
msgstr "Nie udostępniaj nikomu kodu weryfikacyjnego!"

msgid "Don’t share the verification code with anyone!"
msgstr "Nie udostępniaj nikomu kodu weryfikacyjnego!"

msgid "Authenticator QR Code"
msgstr "Kod QR do aplikacji uwierzytelniającej"

msgid "Scan this QR code in your authenticator app, then enter the code below."
msgstr "Zeskanuj ten kod QR w aplikacji uwierzytelniającej, a następnie wpisz kod poniżej."

msgid "6-digit verification code"
msgstr "6-cyfrowy kod weryfikacyjny"

msgid "Digit {0}"
msgstr "Cyfra {0}"

msgid "reCaptcha is not configured! Please configure Users.reCaptcha.key"
msgstr "reCaptcha nie jest skonfigurowana! Skonfiguruj Users.reCaptcha.key"

msgid ""
"If the link is not correctly displayed, please copy the following address in "
"your web browser {0}"
msgstr ""
"Jeśli link nie wyświetla się poprawnie, skopiuj poniższy adres do przeglądarki: "
"{0}"

