# ─── Syntesys Credit Check Microservice ───────────────────────────────────────
# Skopiuj do .env i uzupełnij wartości

# Port serwisu
PORT=3400

# Klucz API (dowolny string, użyj w nagłówku X-Api-Key przy każdym żądaniu)
API_KEY=change-me-to-a-strong-random-secret

# Dane logowania do syntesys.pl
SYNTESYS_USER=login@firma.pl
SYNTESYS_PASS=haslo

# Ścieżka do bazy SQLite
DB_PATH=./data/credit_checks.db

# Ścieżka do pliku sesji Puppeteer (cache cookies)
SESSION_PATH=./data/syntesys-session.json

# Czas życia sesji (ms). Domyślnie 8h = 28800000
SESSION_TTL_MS=28800000

# Timeout scrapera (ms). Domyślnie 90s — syntesys bywa wolne
SCRAPER_TIMEOUT_MS=90000

# Opcjonalnie: ścieżka do Chromium (jeśli puppeteer --no-download)
# CHROME_EXECUTABLE=/usr/bin/chromium-browser
